# Copy to .env.local and fill in. Never commit real values.
# For local Supabase, `pnpm db:start` prints these (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never exposed to the client
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=                      # server only; Vercel Cron sends it to /api/cron/daily
SENTRY_DSN=                       # optional: server error reports (scrubbed of personal data)
NEXT_PUBLIC_SENTRY_DSN=           # optional: browser error reports (same project's DSN)
RATE_LIMIT_SECRET=                # server only: any long random string, used to hash IP addresses
